# Supabase (required — copy from your Supabase project settings)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ToyyibPay Edge Function secrets (set via: supabase secrets set KEY=value)
# Register at https://toyyibpay.com — free Malaysian FPX + credit card gateway
#
# TOYYIBPAY_SECRET_KEY     — from Account > Profile in ToyyibPay dashboard
# TOYYIBPAY_CATEGORY_CODE  — create a Category in ToyyibPay, copy the code
# TOYYIBPAY_SANDBOX        — "true" for testing (uses dev.toyyibpay.com), "false" for live
# APP_URL                  — your deployed app URL, e.g. https://yourapp.com

# Maintenance mode (set VITE_MAINTENANCE=true to show maintenance page)
VITE_MAINTENANCE=false
