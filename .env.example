# Supabase (required — copy from your Supabase project settings)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server secrets: set in Supabase, never as VITE_ variables.
# APP_URL=https://your-deployed-app.com
# PLATFORM_TOYYIBPAY_SECRET_KEY=your-platform-secret
# PLATFORM_TOYYIBPAY_CATEGORY_CODE=your-platform-category
# PLATFORM_TOYYIBPAY_SANDBOX=true
# Platform credentials collect Pro subscriptions. Each workshop separately saves
# its own customer-payment credentials in Settings > Payment Gateway.
# Sandbox accounts/categories come from https://dev.toyyibpay.com;
# live accounts/categories come from https://toyyibpay.com. Do not mix them.

# Maintenance mode (set VITE_MAINTENANCE=true to show maintenance page)
VITE_MAINTENANCE=false
